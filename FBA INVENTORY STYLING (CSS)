/* gui_web\style.css */
#view-fba {
  padding: 16px;
}

.fba-controls, .fba-filters {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.text-input {
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin-right: 8px;
}

.tab-btn {
  background-color: #f5f5f5;
  color: #333;
  border: none;
  padding: 8px 16px;
  cursor: pointer;
  border-radius: 4px;
  transition: background-color 0.3s, color 0.3s;
}

.tab-btn.active {
  background-color: #0288d1;
  color: white;
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: block;
}
