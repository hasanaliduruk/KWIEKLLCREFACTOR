<!-- gui_web\index.html -->
<section id="view-fba" class="view">
  <div class="view-header">
    <h2>FBA Inventory & FIFO Pro</h2>
    <p class="muted">SKT ve FIFO tabanlı stok erime analizi.</p>
  </div>

  <div class="card fba-controls">
    <button id="fba-btn-master" class="btn btn-primary">📂 Master Excel</button>
    <button id="fba-btn-picklist" class="btn" style="background-color: #0288d1; color: white;">📦 2D Picklist</button>
    <button id="fba-btn-stock" class="btn" style="background-color: #7b1fa2; color: white;">📊 AMZ Stok</button>
    <button id="fba-btn-detect" class="btn" style="background-color: #e65100; color: white;">🔍 ID Tespit</button>
    <button id="fba-btn-reset" class="btn" style="background-color: #c62828; color: white;">⚠️ Sıfırla</button>
    <div style="flex: 1;"></div>
    <button id="fba-btn-export" class="btn" style="background-color: #2e7d32; color: white;">📥 Excel Çıktısı</button>
  </div>

  <div class="card fba-filters">
    <input type="number" id="fba-skt-min" class="text-input" placeholder="Min SKT Gün" style="width: 70px;">
    <input type="number" id="fba-skt-max" class="text-input" placeholder="Max SKT Gün" style="width: 70px;">
    <span> | </span>
    <input type="number" id="fba-amz-min" class="text-input" placeholder="Min AMZ Stok Gün" style="width: 70px;">
    <input type="number" id="fba-amz-max" class="text-input" placeholder="Max AMZ Stok Gün" style="width: 70px;">
    <button id="fba-btn-clear-filters" class="btn btn-sm">Sıfırla</button>
    <div style="flex: 1;"></div>
    <input type="text" id="fba-search" class="text-input" placeholder="🔍 SKU veya ID Ara..." style="width: 200px;">
  </div>

  <!-- TABS -->
  <div class="tabs">
    <button class="tab-btn active" data-target="sirali">SIRALI</button>
    <button class="tab-btn" data-target="analiz">ANALİZ (FIFO)</button>
    <button class="tab-btn" data-target="amz">AMAZON GÜNCEL STOK</button>
  </div>

  <!-- TAB CONTENTS -->
  <div id="sirali" class="tab-pane active">
    <table class="data-table" id="fba-table-sirali">
      <thead><tr><th>SHIPMENT NAME</th><th>SHIPMENT ID</th><th>DATE</th><th>SKU</th><th>QTY</th><th>EXP USA</th><th>EXP TUR</th><th>SKT GÜN</th><th>AMZ GÜN</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>

  <div id="analiz" class="tab-pane">
    <table class="data-table" id="fba-table-analiz">
      <thead><tr><th>SHIPMENT NAME</th><th>SHIPMENT ID</th><th>SKU</th><th>QTY</th><th>AMZ STOK</th><th>AMZ GÜN</th><th>SKT GÜN</th><th>NOT</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>

  <div id="amz" class="tab-pane">
    <table class="data-table" id="fba-table-amz">
      <thead><tr><th>SKU</th><th>Total Units</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
</section>
